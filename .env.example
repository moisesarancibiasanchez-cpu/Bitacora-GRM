# =============================================================================
# Bitácora GRM — plantilla de variables de entorno
# =============================================================================
# Copia este archivo a `.env` para desarrollo local:
#     cp .env.example .env
#
# En Railway (u otro PaaS) configura estas variables desde el panel
# "Variables" del servicio. Los valores se inyectan al proceso en arranque.
#
# ⚠️  En producción (ENVIRONMENT=prod) TODAS las variables de Seguridad
#     son obligatorias. El servidor fallará al arrancar si falta alguna.
# =============================================================================


# -----------------------------------------------------------------------------
# 🗄️  Base de datos
# -----------------------------------------------------------------------------
# URL de conexión SQLAlchemy. En Railway, copia el valor de la variable
# DATABASE_URL que el plugin PostgreSQL expone automáticamente.
#   - Local:   postgresql+psycopg2://bitacora:bitacora@localhost:5432/bitacora_grm
#   - Railway: postgresql+psycopg2://postgres:xxxxx@containers-us-west-xxx.railway.app:5432/railway
DATABASE_URL=postgresql+psycopg2://bitacora:bitacora@localhost:5432/bitacora_grm

# Tamaño del pool de conexiones SQLAlchemy.
POOL_SIZE=10
MAX_OVERFLOW=20

# Imprime las SQL generadas en stdout. Útil en dev, NUNCA en prod.
ECHO_SQL=false


# -----------------------------------------------------------------------------
# 📋  Logging / entorno
# -----------------------------------------------------------------------------
# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Entorno de ejecución: dev | staging | prod
# - dev:     CORS permisivo (acepta "*"), logs verbosos.
# - staging: CORS restrictivo (exige lista explícita).
# - prod:    CORS restrictivo + validaciones estrictas.
#
# ⚠️  Si despliegas en Railway/Heroku/Producción, este valor DEBE ser "prod".
#     De lo contrario el endpoint GET / mostrará "environment: dev" y la
#     política CORS será insegura.
ENVIRONMENT=dev


# -----------------------------------------------------------------------------
# 🔒  Seguridad
# -----------------------------------------------------------------------------
# Orígenes permitidos para CORS (separados por coma, sin espacios).
# Ejemplo: CORS_ORIGINS=https://app.banco.local,https://admin.banco.local
#
# Comportamiento según entorno:
#   - dev:     si está vacía o vale "*", se acepta cualquier origen.
#   - staging: DEBE ser una lista de orígenes http(s) explícitos. NUNCA "*".
#   - prod:    igual que staging, además falla al arrancar si está vacía.
#
# ⚠️  Para producción en Railway, usa el dominio público exacto que
#     Railway te asigna (o tu dominio personalizado).
CORS_ORIGINS=

# Cabecera HTTP que identifica al usuario actual (autenticación ligera).
# Por defecto: X-User-Id
AUTH_HEADER_NAME=X-User-Id


# =============================================================================
# 📦  Configuración típica por entorno
# =============================================================================
#
# 🧑‍💻 DESARROLLO LOCAL (archivo .env)
# -----------------------------------------------------------------------------
#   DATABASE_URL=postgresql+psycopg2://bitacora:bitacora@localhost:5432/bitacora_grm
#   ENVIRONMENT=dev
#   CORS_ORIGINS=
#   LOG_LEVEL=DEBUG
#   ECHO_SQL=true
#
# ☁️  RAILWAY — STAGING
# -----------------------------------------------------------------------------
#   DATABASE_URL=<pegar el valor del plugin PostgreSQL>
#   ENVIRONMENT=staging
#   CORS_ORIGINS=https://staging.tu-dominio.com
#   LOG_LEVEL=INFO
#
# ☁️  RAILWAY — PRODUCCIÓN
# -----------------------------------------------------------------------------
#   DATABASE_URL=<pegar el valor del plugin PostgreSQL>
#   ENVIRONMENT=prod
#   CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
#   LOG_LEVEL=INFO
#   ECHO_SQL=false
# =============================================================================
