# Bitácora GRM — variables de entorno (copiar a .env)
# =========================================================================
# Base de datos
# =========================================================================
DATABASE_URL=postgresql+psycopg2://bitacora:bitacora@localhost:5432/bitacora_grm
POOL_SIZE=10
MAX_OVERFLOW=20
ECHO_SQL=false

# =========================================================================
# Logging / entorno
# =========================================================================
LOG_LEVEL=INFO
# dev | staging | prod
ENVIRONMENT=dev

# =========================================================================
# Seguridad
# =========================================================================
# Orígenes permitidos para CORS (separados por coma).
# En dev se acepta "*" por defecto si esta lista está vacía o no se define.
# En staging/prod DEBE especificar orígenes concretos.
# Ejemplo: CORS_ORIGINS=https://app.banco.local,https://admin.banco.local
CORS_ORIGINS=

# Cabecera HTTP que identifica al usuario actual (autenticación ligera).
AUTH_HEADER_NAME=X-User-Id
